DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-this-password"
NEXT_PUBLIC_APP_NAME="Wareflow"

# --- Email OTP ---
# Brevo (bisa mengirim ke penerima mana pun setelah alamat pengirim diverifikasi,
# tanpa perlu punya domain sendiri). Verifikasi di app.brevo.com → Senders.
BREVO_API_KEY=""
EMAIL_FROM="Wareflow <alamat-yang-diverifikasi@gmail.com>"
# Resend tetap didukung, tetapi butuh domain terverifikasi untuk mengirim ke
# pengguna lain. `onboarding@resend.dev` hanya bisa mengirim ke email pemilik akun.
RESEND_API_KEY=""

# Tampilkan kode OTP di respons API hanya untuk development.
OTP_DEV_ECHO="false"
# Jeda minimum antar permintaan OTP (detik). 0 = tanpa jeda.
OTP_RESEND_COOLDOWN_SECONDS="60"

GEMINI_API_KEY=""
GEMINI_MODEL=""
AI_DAILY_LIMIT="30"
